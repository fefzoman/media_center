# nginx is the only published service. Use the Dell's LAN IP to restrict binding.
HTTP_BIND_ADDRESS=0.0.0.0
HTTP_PORT=80

# Backend container listener; keep 0.0.0.0 so nginx can reach it.
MEDIA_CENTER_HOST=0.0.0.0
MEDIA_CENTER_PORT=8000

# Reserved for Phase 1; these do not configure a torrent engine in Phase 0.
TORRSERVER_BASE_URL=http://torrserver:8090
TORRENT_CACHE_MB=1024
TORRENT_USE_DISK=false

# Absolute SQLite path inside the container; persistence begins in Phase 2.
DATABASE_URL=sqlite:////data/media-center.db
TV_BASE_URL=http://192.168.0.81
DEFAULT_CLIENT_ID=lg-living-room
