# nginx is the only HTTP service exposed to the LAN.
HTTP_BIND_ADDRESS=0.0.0.0
HTTP_PORT=80

MEDIA_CENTER_HOST=0.0.0.0
MEDIA_CENTER_PORT=8000

TORRSERVER_BASE_URL=http://torrserver:8090
TORRSERVER_VERSION=MatriX.142.LT-1.1.8
TORRSERVER_REQUEST_TIMEOUT_SECONDS=10
TORRSERVER_METADATA_TIMEOUT_SECONDS=120
TORRSERVER_POLL_INTERVAL_SECONDS=1
TORRENT_PEER_PORT=32000
TORRENT_CACHE_MB=1024
TORRENT_USE_DISK=false
ENABLE_DEBUG_ENDPOINT=true

DATABASE_URL=sqlite:////data/media-center.db
# Creative Commons test title. Replace with another authorized torrent source if desired.
CATALOG_SEED_TORRENT_URI=https://webtorrent.io/torrents/sintel.torrent
TV_BASE_URL=http://192.168.1.50
DEFAULT_CLIENT_ID=lg-living-room
